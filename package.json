{
  "name": "rpg-studio",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "mongodb": "$mongodb"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.1": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true,
    "mongodb-memory-server@10.3.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "cypress@16.0.0": true
  }
}
